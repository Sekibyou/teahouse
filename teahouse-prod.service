[Unit]
Description=Teahouse — Backend API + static frontend (single-port, dist, :8888)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lowstar
WorkingDirectory=/home/lowstar/projects/teahouse
ExecStart=/home/lowstar/projects/teahouse/.venv/bin/python -m teahouse.app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
