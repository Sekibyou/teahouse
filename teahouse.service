[Unit]
Description=Teahouse — Backend API (dev: hot-reload, no dist)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lowstar
WorkingDirectory=/home/lowstar/projects/teahouse
ExecStart=/home/lowstar/projects/teahouse/.venv/bin/python -m teahouse.app --dev
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
